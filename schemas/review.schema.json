{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DMP Review",
  "description": "A seller review in the Distributed Marketplace Protocol",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^Qm[1-9A-Za-z]{44}$",
      "description": "IPFS CID (base58 multihash)"
    },
    "sellerId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{130}$",
      "description": "Seller's ECDSA public key"
    },
    "listingId": {
      "type": "string",
      "description": "CID of the listing being reviewed"
    },
    "score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating score (1-5)"
    },
    "comment": {
      "type": "string",
      "maxLength": 500,
      "description": "Review text"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{130}$",
          "description": "Reviewer's ECDSA public key"
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]+$",
      "description": "ECDSA signature in hex (DER-encoded)"
    }
  },
  "required": ["id", "sellerId", "score", "reviewer", "timestamp", "signature"],
  "additionalProperties": false
}
