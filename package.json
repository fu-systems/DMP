    "secp256k1": "^5.0.1",
    "uint8arrays": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "@types/sanitize-html": "^2.13.0",
    "@types/secp256k1": "^4.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
