{
  "name": "dmp-protocol",
  "version": "1.0.0",
  "description": "Distributed Marketplace Protocol - A censorship-resistant, peer-to-peer protocol for decentralized marketplace listings",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
